# Tambo AI — required for the /chat assistant (get a key at https://tambo.co/dashboard)
NEXT_PUBLIC_TAMBO_API_KEY=api-key-here

# Optional: custom Tambo API endpoint
# NEXT_PUBLIC_TAMBO_URL=

# Public site URL — used for canonical URLs, OpenGraph, sitemap and JSON-LD.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: contact email shown across the site
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional: GA4 measurement ID override. The production property is set in
# src/content/site.ts and loads automatically in production builds that have
# NEXT_PUBLIC_SITE_URL set. Set this to point a preview/staging host at its own
# property (without it, a staging build with a public URL reports to production),
# or to turn analytics on in `next dev` (off by default). A malformed value
# disables analytics for that build and warns at build time.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense. Ads stay off until the publisher ID is set. With Auto ads
# enabled in the AdSense dashboard the ID alone is enough; the optional slot
# adds one manual in-article unit (digits only, from an ad unit you create).
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=1234567890
